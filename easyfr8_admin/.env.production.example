# =================================
# EasyFr8 API Production Environment Example
# =================================

# Server
NODE_ENV=production
PORT=3001


# =================================
# Admin + API URL
# =================================

NEXT_PUBLIC_API_BASE_URL=https://adminfr8.vnvision.in/api

NEXT_PUBLIC_BASE_URL=https://adminfr8.vnvision.in

NEXT_PUBLIC_IMAGE_URL=https://adminfr8.vnvision.in/images


# =================================
# User Website URL
# =================================

NEXT_PUBLIC_SITE_URL=https://easyfr8.vnvision.in

USER_PANEL_URL=https://easyfr8.vnvision.in


# =================================
# Internal API
# =================================

API_URL=https://adminfr8.vnvision.in


# =================================
# Authentication
# =================================

JWT_SECRET=your_strong_jwt_secret_here


# =================================
# aaPanel MySQL Database
# =================================

DB_HOST=127.0.0.1
DB_PORT=3306

DB_DATABASE=easyfr8

DB_USERNAME=

DB_PASSWORD=


# =================================
# File Uploads
# =================================

UPLOAD_PATH=uploads

IMAGE_URL=https://adminfr8.vnvision.in/images
